<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/storh/ontologies/2022/11/StaDiOS"
         xmlns="http://www.semanticweb.org/storh/ontologies/2022/11/StaDiOS#">

<owl:Ontology rdf:about="#">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ontology for the standard description of diseases and the generation of knowledge bases to facilitate cost-utility studies.</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#hasClinicalDiagnosisStepsStrategy">
  <rdfs:domain rdf:resource="#ClinicalDiagnosisDetectionStrategy"/>
  <rdfs:range rdf:resource="#ClinicalDiagnosisDetectionStepStrategy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDetection">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#StepStrategy"/>
  <rdfs:range rdf:resource="#Detection"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDetectionCost">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Detection"/>
  <rdfs:range rdf:resource="#Cost"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDetectionStrategy">
  <rdfs:domain rdf:resource="#Disease"/>
  <rdfs:range rdf:resource="#DetectionStrategy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDetectionStrategyCost">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#DetectionStrategy"/>
  <rdfs:range rdf:resource="#Cost"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDevelopment">
  <rdfs:domain rdf:resource="#DevelopmentModification"/>
  <rdfs:range rdf:resource="#Development"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDevelopmentManifestations">
  <rdfs:domain rdf:resource="#Development"/>
  <rdfs:range rdf:resource="#Manifestation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDevelopmentModifications">
  <rdfs:domain rdf:resource="#Intervention"/>
  <rdfs:range rdf:resource="#DevelopmentModification"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDiseaseDevelopments">
  <rdfs:domain rdf:resource="#Disease"/>
  <rdfs:range rdf:resource="#Development"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDiseaseFollowUpStrategy">
  <rdfs:domain rdf:resource="#Disease"/>
  <rdfs:range rdf:resource="#FollowUpStrategy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDiseaseTreatmentStrategy">
  <rdfs:domain rdf:resource="#Disease"/>
  <rdfs:range rdf:resource="#TreatmentStrategy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Describes any non-drug intervention used to treat a disease or manifestation</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDrugCost">
  <rdfs:domain rdf:resource="#Drug"/>
  <rdfs:range rdf:resource="#Cost"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDrugGuidelines">
  <rdfs:domain rdf:resource="#Drug"/>
  <rdfs:range rdf:resource="#Guidelines"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDrugs">
  <rdfs:domain rdf:resource="#Treatment"/>
  <rdfs:range rdf:resource="#Drug"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasFollowUp">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#FollowUpStepStrategy"/>
  <rdfs:range rdf:resource="#FollowUp"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasFollowUpCost">
  <rdfs:domain rdf:resource="#FollowUp"/>
  <rdfs:range rdf:resource="#Cost"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasFollowUpGuidelines">
  <rdfs:domain rdf:resource="#FollowUp"/>
  <rdfs:range rdf:resource="#Guidelines"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasFollowUpStepsStrategy">
  <rdfs:domain rdf:resource="#FollowUpStrategy"/>
  <rdfs:range rdf:resource="#FollowUpStepStrategy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasFollowUpStrategyCost">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#FollowUpStrategy"/>
  <rdfs:range rdf:resource="#Cost"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasFollowUpStrategyGuidelines">
  <rdfs:domain rdf:resource="#FollowUpStrategy"/>
  <rdfs:range rdf:resource="#Guidelines"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasGuidelineUtility">
  <rdfs:domain rdf:resource="#Guidelines"/>
  <rdfs:range rdf:resource="#Utility"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasInterventionDetectionStrategy">
  <rdfs:domain rdf:resource="#Intervention"/>
  <rdfs:range rdf:resource="#DetectionStrategy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasInterventionFollowUpStrategy">
  <rdfs:domain rdf:resource="#Intervention"/>
  <rdfs:range rdf:resource="#FollowUpStrategy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasInterventionPopulation">
  <rdfs:domain rdf:resource="#Intervention"/>
  <rdfs:range rdf:resource="#Population"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasInterventionTreatmentStrategy">
  <rdfs:domain rdf:resource="#Intervention"/>
  <rdfs:range rdf:resource="#TreatmentStrategy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasInterventions">
  <rdfs:domain rdf:resource="#Disease"/>
  <rdfs:range rdf:resource="#Intervention"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A disease to be studied will have technologies or procedures used to modify the natural history of the disease.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasManifestationCost">
  <rdfs:domain rdf:resource="#Manifestation"/>
  <rdfs:range rdf:resource="#Cost"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasManifestationFollowUpStrategy">
  <rdfs:domain rdf:resource="#Manifestation"/>
  <rdfs:range rdf:resource="#FollowUpStrategy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasManifestationModification">
  <rdfs:domain rdf:resource="#Intervention"/>
  <rdfs:range rdf:resource="#ManifestationModification"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasManifestationTreatmentStrategy">
  <rdfs:domain rdf:resource="#Manifestation"/>
  <rdfs:range rdf:resource="#TreatmentStrategy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasManifestations">
  <rdfs:domain rdf:resource="#ManifestationModification"/>
  <rdfs:range rdf:resource="#Manifestation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPopulationUtility">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Population"/>
  <rdfs:range rdf:resource="#Utility"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasReferences">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Disease"/>
  <rdfs:range rdf:resource="#Reference"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A disease recorded in the ontology will have references to external contrasted medical ontologies.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasScreeningStepsStrategy">
  <rdfs:domain rdf:resource="#ScreeningDetectionStrategy"/>
  <rdfs:range rdf:resource="#ScreeningDetectionStepStrategy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasTreatment">
  <rdfs:domain rdf:resource="#TreatmentStepStrategy"/>
  <rdfs:range rdf:resource="#Treatment"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasTreatmentCost">
  <rdfs:domain rdf:resource="#Treatment"/>
  <rdfs:range rdf:resource="#Cost"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasTreatmentGuidelines">
  <rdfs:domain rdf:resource="#Treatment"/>
  <rdfs:range rdf:resource="#Guidelines"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasTreatmentStepsStrategy">
  <rdfs:domain rdf:resource="#TreatmentStrategy"/>
  <rdfs:range rdf:resource="#TreatmentStepStrategy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasTreatmentStrategyCost">
  <rdfs:domain rdf:resource="#TreatmentStrategy"/>
  <rdfs:range rdf:resource="#Cost"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasTreatmentStrategyGuidelines">
  <rdfs:domain rdf:resource="#TreatmentStrategy"/>
  <rdfs:range rdf:resource="#Guidelines"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasUtility">
  <rdfs:domain rdf:resource="#Manifestation"/>
  <rdfs:range rdf:resource="#Utility"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasAmountProbabilityDistribution">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasAverageAge">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCalculationMethod">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCondition">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">It allows expressing conditions based on parameters that we will find in the model. For example, we can find that certain drugs will be administered depending on the weight or age of the patient. The language in which the conditions are expressed is in EL format (Expression Language: JSR-341).</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasConditions">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCountry">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCountryContext">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Contains the context in which a parameter is studied within a country. This can be at the level of city, state, autonomous community, or region.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCurrency">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasDescription">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Description</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasDevelopmentKind">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MODIFIED</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NATURAL</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasDose">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dosage of the indicated drug</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasDuration">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasEndAge">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasEtiology">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Etiology</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasFemaleProportion">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasFrequency">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates the time cycle of how often the treatment, the follow-up test or their respective strategies have to be applied. In the case of a manifestation of the disease, it will indicate how many times a year the symptom manifests itself. 

By default = 1, for the Manifestations.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasFrequencyModification">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasHoursInterval">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval in which the indicated dose of drug should be given.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasIdentifier">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stores the identifier of an instance. The objective of this field is to facilitate the identification and relationship between instances with a view to software programming.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasInitialAmount">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasInterventionKind">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIAGNOSIS</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GENERAL</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCREENING</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasLifeExpectancy">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasLifeExpectancyModification">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasLifeExpectancyProbabilityDistribution">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMaleProportion">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasManifestationKind">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ACUTE</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHRONIC</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasModificationKind">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIFF</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RR</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SET</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMortalityFactor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMortalityFactorModification">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMortalityFactorProbabilityDistribution">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasOnSetAge">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPercentForNext">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPercentageTreated">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPopulationKind">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ADOLESCENT</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ADULT</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ELDERLY</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">INFANT</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NEONATAL</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPresentation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CLASSIC</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NON-CLASSIC</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPrevalenceAtBirth">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The prevalence of a disease is the total number of individuals presenting an attribute or disease at a time or during a period divided by the population at that point in time or in the middle of the period. Quantifies the proportion of people in a population who have a disease (or any other event) at a given time and provides an estimate of the proportion of subjects in that population who have the disease at that time.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasProbability">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasProbabilityDistribution">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasProbabilityModification">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasProbabilityOfDiagnosis">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Probability that the manifestation presented, the clinical diagnosis is made.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasProbabilityOfDiagnosisModification">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasRange">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Age range in which the drug will be delivered.

Examples: 
   0y-2y    =&gt; 0 years to 2 years
   3m-2y   =&gt; 3 months to 2 years</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasRarity">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">COMMON</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RARE</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasReference">
  <rdfs:domain rdf:resource="#Reference"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasRelativeRisk">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasRelativeRiskModification">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSensitivity">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Sensitivity in epidemiology is the Probability of correctly classifying a sick individual, that is, the Probability that a positive result will be obtained in a diagnostic test for a sick subject. The Sensitivity is, therefore, the ability of the complementary test to detect the disease. Sensitivity is the percentage of true positives or the Probability that the test is positive if the disease is present; False negatives are sick subjects diagnosed as healthy.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSize">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSource">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSpecificity">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Specificity of a test is the Probability that a healthy subject will have a negative test result. Specificity is the percentage of true negatives or the Probability that the test will be negative if the disease is not present. False positives are healthy subjects diagnosed as sick.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSpecificityProbabilityDistribution">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasStage">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasStepOrder">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasStudyIdentifier">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasTemporalBehavior">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANNUAL</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LIFETIME</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ONETIME</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ONETIME: the cost/utility applies only once at the time of the event.
ANNUAL: the cost/utility indicates that the indicated value affects annually throughout the patient's life.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasUtilityKind">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:oneOf>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DISUTILITY</rdf:first>
        <rdf:rest>
        <rdf:Description>
      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UTILITY</rdf:first>
        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
        </rdf:rest>
        </rdf:Description>
      </owl:oneOf>
    </rdfs:Datatype>
  </rdfs:range>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasValueProbabilityDistribution">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasYear">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Year in which the parameter data is collected</rdfs:comment>
</owl:DatatypeProperty>

<owl:Class rdf:about="#ClinicalDiagnosisDetectionStrategy">
  <rdfs:subClassOf rdf:resource="#DetectionStrategy"/>
  <owl:disjointWith rdf:resource="#ScreeningDetectionStrategy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process of identifying a disease, condition, or injury based on the signs and symptoms a patient is having and the patient’s health history and physical exam. Further testing, such as blood tests, imaging tests, and biopsies, may be done after a clinical diagnosis is made.</rdfs:comment>
  <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.cancer.gov/publications/dictionaries/cancer-terms/def/clinical-diagnosis</rdfs:isDefinedBy>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ClinicalDiagnosisDetectionStrategy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ClinicalDiagnosisDetectionStepStrategy">
  <rdfs:subClassOf rdf:resource="#StepStrategy"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Describes the various steps involved in completing a clinical diagnosis procedure.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ClinicalDiagnosisDetectionStepStrategy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#StepStrategy">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasCondition"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasDescription"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
      <owl:onProperty rdf:resource="#hasPercentForNext"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <owl:onProperty rdf:resource="#hasStepOrder"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasCondition"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasDescription"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
      <owl:onProperty rdf:resource="#hasPercentForNext"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
      <owl:onProperty rdf:resource="#hasStepOrder"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Describes the different steps to be followed to complete a given procedure.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">StepStrategy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Detection">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasDescription"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasIdentifier"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasSensitivity"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasSpecificity"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasDescription"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasIdentifier"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasSensitivity"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasSpecificity"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">It contains the information necessary to quantitatively analyze a given screening procedure applied to a specific disease.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Detection</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Cost">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasAmount"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasCountry"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasCountryContext"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasCurrency"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasDescription"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasInitialAmount"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasSource"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasYear"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onDataRange>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANNUAL</rdf:first>
            <rdf:rest>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LIFETIME</rdf:first>
            <rdf:rest>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ONETIME</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
            </rdf:rest>
            </rdf:Description>
            </rdf:rest>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:onDataRange>
      <owl:onProperty rdf:resource="#hasTemporalBehavior"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasAmount"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasCountry"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasCountryContext"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasCurrency"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasDescription"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasInitialAmount"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasSource"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasYear"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onDataRange>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ANNUAL</rdf:first>
            <rdf:rest>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LIFETIME</rdf:first>
            <rdf:rest>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ONETIME</rdf:first>
            <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
            </rdf:rest>
            </rdf:Description>
            </rdf:rest>
            </rdf:Description>
          </owl:oneOf>
        </rdfs:Datatype>
      </owl:onDataRange>
      <owl:onProperty rdf:resource="#hasTemporalBehavior"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stores the details related to the economic value of the resources involved in interventions, treatments, follow-up tests, etc.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cost</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Disease">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasDescription"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasIdentifier"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasRarity"/>
      <owl:someValuesFrom>
        <rdfs:Datatype>
          <owl:oneOf>
            <rdf:Description>
          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NOT-RARE</rdf:first>
            <rdf:rest>
            <rdf:Description>
